{
  "name": "notely-advanced-notepad",
  "private": true,
  "version": "1.1.0",
  "description": "Private rich-text notepad for Chrome: side panel notes, Markdown shortcuts, checklists, web clipper and version history. 100% local.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc -b && vite build",
    "build:fast": "vite build",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "dompurify": "^3.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.7.2",
    "vite": "^7.1.0"
  },
  "homepage": "https://github.com/Toolvanta/notely#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toolvanta/notely.git"
  },
  "bugs": {
    "url": "https://github.com/Toolvanta/notely/issues"
  },
  "author": {
    "name": "Shoaib Arif",
    "url": "https://shoaibarif.vercel.app/"
  },
  "funding": {
    "type": "individual",
    "url": "http://toolenhancer.com/"
  },
  "keywords": [
    "chrome-extension",
    "notepad",
    "notes",
    "side-panel",
    "web-clipper",
    "markdown",
    "tiptap"
  ]
}
